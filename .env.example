# Google Cloud OAuth 2.0 Web application redirect URI:
# http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
APP_ORIGIN=http://localhost:3000

# Use a unique random value of at least 24 characters. Do not change it after
# connecting accounts; it encrypts the saved Google refresh tokens.
MEGADRIVE_ENCRYPTION_KEY=replace-with-a-long-random-secret
